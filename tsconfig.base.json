{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@studio/contracts": ["packages/contracts/src/index.ts"],
      "@studio/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@studio/prompt-kits": ["packages/prompt-kits/src/index.ts"]
    }
  }
}
